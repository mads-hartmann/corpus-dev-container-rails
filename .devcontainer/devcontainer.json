{
	"name": "corpus-dev-container-rails",
	"image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
	"features": {
		"ghcr.io/devcontainers/features/ruby": {
			"version": "3.4.9"
		}
	},
	"forwardPorts": [3000],
	"portsAttributes": {
		"3000": {
			"label": "Rails",
			"onAutoForward": "notify"
		}
	}
}
